# Azure AI Foundry Project Configuration
# Get this from the Azure AI Foundry portal > Project Settings > Overview
PROJECT_ENDPOINT=https://<your-project-name>.<region>.api.azureml.ms

# Model deployment name (the name of your deployed model in Azure AI Foundry)
MODEL_DEPLOYMENT_NAME=gpt-4o

# Optional: Bing Search Connection
# Required for web grounding capabilities
# Create in Azure AI Foundry > Settings > Connected Resources > + Connect > Bing Search
BING_CONNECTION_NAME=your-bing-connection-name

# Optional: Azure AI Search Connection  
# Required for enterprise search capabilities
# Create in Azure AI Foundry > Settings > Connected Resources > + Connect > Azure AI Search
AZURE_AI_SEARCH_CONNECTION_NAME=your-search-connection-name
AZURE_AI_SEARCH_INDEX_NAME=your-index-name
